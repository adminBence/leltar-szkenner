  const pendingItems = scanned.filter(s => !s.synced);

  if (APPS_SCRIPT_URL && activeLeltar && pendingItems.length) {
    try {
      await apiPost({
        action: "submit_scans",
        leltar_id: activeLeltar.leltar_id,
