async function apiGet(params) {
  if (!APPS_SCRIPT_URL) throw new Error("Nincs beállítva az Apps Script URL (lásd a kód elején).");
  const qs = Object.entries({ ...params, key: APPS_SCRIPT_KEY })
    .map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join("&");
  const res = await fetch(`${APPS_SCRIPT_URL}?${qs}`);
  return res.json();
}
async function apiPost(body) {
  if (!APPS_SCRIPT_URL) throw new Error("Nincs beállítva az Apps Script URL (lásd a kód elején).");
  // text/plain content-type, hogy elkerüljük a CORS preflight-ot Apps Scriptnél.
  const res = await fetch(APPS_SCRIPT_URL, {
    method: "POST",
    headers: { "Content-Type": "text/plain;charset=utf-8" },
