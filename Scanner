     ahol a mennyiség utólag is állítható +/- gombokkal.
   - Új beolvasásnál, ha épp csukva van a lista, a sáv egy röpke
     "bump" mozdulattal jelez.
   ========================================================================= */
let listExpanded = false;
let lastRenderedCount = 0;

function rowItemHtml(s) {
  return `
    <div class="rowItem">
      <div class="info">
        <b>${escapeHtml(s.name)}</b>
        <span>${s.barcode} · ${s.sector}</span>
      </div>
      <div class="qtyEdit">
        <button class="qMinus" data-barcode="${s.barcode}" data-sector="${s.sector}" aria-label="Mennyiség csökkentése">–</button>
        <span class="qtyVal">${s.qty}</span>
        <button class="qPlus" data-barcode="${s.barcode}" data-sector="${s.sector}" aria-label="Mennyiség növelése">+</button>
      </div>
      <button class="delBtn" data-barcode="${s.barcode}" data-sector="${s.sector}" aria-label="Tétel törlése">✕</button>
    </div>`;
}

function findScannedItem(barcode, sector) {
  return scanned.find(s => s.barcode === barcode && s.sector === sector);
}

function bindRowEvents(container) {
  container.querySelectorAll(".qMinus").forEach(btn => btn.addEventListener("click", () => {
    const it = findScannedItem(btn.dataset.barcode, btn.dataset.sector);
    if (it) { it.qty = Math.max(1, it.qty - 1); it.synced = false; renderList(); }
  }));
  container.querySelectorAll(".qPlus").forEach(btn => btn.addEventListener("click", () => {
    const it = findScannedItem(btn.dataset.barcode, btn.dataset.sector);
    if (it) { it.qty += 1; it.synced = false; renderList(); }
  }));
  container.querySelectorAll(".delBtn").forEach(btn => btn.addEventListener("click", (e) => {
    e.stopPropagation();
    askDeleteConfirmation(btn.dataset.barcode, btn.dataset.sector);
  }));
}

/* ---------- Törlés megerősítése ---------- */
let pendingDelete = null;
function askDeleteConfirmation(barcode, sector) {
  const it = findScannedItem(barcode, sector);
  if (!it) return;
  pendingDelete = { barcode, sector };
  el("confirmName").textContent = `${it.name} (${it.qty} db)`;
  el("confirmOverlay").classList.add("show");
}
el("confirmCancel").addEventListener("click", () => {
  pendingDelete = null;
  el("confirmOverlay").classList.remove("show");
});
el("confirmDelete").addEventListener("click", () => {
  if (pendingDelete) {
    scanned = scanned.filter(s => !(s.barcode === pendingDelete.barcode && s.sector === pendingDelete.sector));
  }
  pendingDelete = null;
  el("confirmOverlay").classList.remove("show");
  renderList();
});

function renderList() {
  const items = scanned.filter(s => !currentSector || s.sector === currentSector);
  el("itemCount").textContent = items.length;
  updatePendingCount();

  const panel = el("listPanel");
  if (!items.length) {
    panel.classList.add("empty");
    el("latestRow").innerHTML = "";
    el("list").innerHTML = "";
    el("listToggle").classList.remove("show");
    lastRenderedCount = 0;
    return;
  }
  panel.classList.remove("empty");
  panel.classList.toggle("expanded", listExpanded);

  // A legutolsó tétel — ugyanolyan, teljesen szerkeszthető sor, mint a
  // lenyitható listában bármelyik másik, plusz egy nyíl jelzi, hogy
  // rákoppintva ki-/becsukható a korábbiak listája.
  const latest = items[0];
  el("latestRow").innerHTML = rowItemHtml(latest);
  bindRowEvents(el("latestRow"));

  // Csak akkor mutatjuk a lenyitó fület, ha van mit lenyitni.
  const toggle = el("listToggle");
  toggle.classList.toggle("show", items.length > 1);
  el("toggleLabel").textContent = listExpanded
    ? "Összecsukás"
    : `+${items.length - 1} korábbi tétel`;

  // Lenyitható lista: a korábbiak (a legutolsó már fent, a rögzített
  // sorban látszik, itt nem ismételjük meg).
  el("list").innerHTML = items.slice(1).map(rowItemHtml).join("");
  bindRowEvents(el("list"));

  // Bump animáció, ha új tétel érkezett.
  if (items.length > lastRenderedCount) {
    panel.classList.remove("bump");
    void panel.offsetWidth;
    panel.classList.add("bump");
  }
  lastRenderedCount = items.length;
}

el("listToggle").addEventListener("click", () => {
  listExpanded = !listExpanded;
  renderList();
});

// A legutolsó, mindig látható tételre bárhova koppintva is nyit/csuk —
// kivéve, ha épp a mennyiség-gombokat vagy a törlést érintjük.
el("latestRow").addEventListener("click", (e) => {
  if (e.target.closest(".qtyEdit, .delBtn")) return;
  listExpanded = !listExpanded;
  renderList();
});

function escapeHtml(str) {
  const d = document.createElement("div");
  d.textContent = str;
  return d.innerHTML;
}

