<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Leltár szkenner</title>
<style>
  :root{
    --bg:#0d1210;
    --panel:#161d1a;
    --panel-2:#1f2925;
    --line:#2a3530;
    --text:#eef2f0;
    --text-dim:#8fa199;
    --accent:#3ecf8e;
    --accent-dim:#1f6b4c;
    --warn:#e0a63e;
    --danger:#e0553e;
    --radius:14px;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0; height:100%; background:var(--bg); color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
    overscroll-behavior:none;}
  #app{display:flex; flex-direction:column; height:100vh; height:100dvh;}

  /* ---------- Fejléc ---------- */
  header{flex:0 0 auto; display:flex; align-items:center; gap:10px;
    padding:10px 14px; background:var(--panel); border-bottom:1px solid var(--line);}
  #menuBtn{flex:0 0 auto; width:38px; height:38px; border-radius:10px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--text); font-size:17px;}
  header select{
    flex:1; background:var(--panel-2); color:var(--text); border:1px solid var(--line);
    border-radius:10px; padding:9px 10px; font-size:15px; font-weight:500;}
  .stat{display:flex; flex-direction:column; align-items:flex-end; line-height:1.2;}
  .stat b{font-size:16px; font-weight:600;}
  .stat span{font-size:11px; color:var(--text-dim);}
  .dot{width:8px; height:8px; border-radius:50%; background:var(--text-dim); flex:0 0 auto;}
  .dot.online{background:var(--accent);}
  .dot.offline{background:var(--danger);}

  /* ---------- Hamburgermenü ---------- */
  #menuOverlay{display:none; position:fixed; inset:0; z-index:60; background:rgba(0,0,0,0.55);}
  #menuOverlay.show{display:block;}
  #menuBox{position:absolute; top:0; left:0; bottom:0; width:78%; max-width:300px;
    background:var(--panel); border-right:1px solid var(--line); padding:16px;
    display:flex; flex-direction:column; gap:8px;}
  .menuItem{text-align:left; padding:14px 12px; border-radius:10px; border:none;
    background:var(--panel-2); color:var(--text); font-size:15px; font-weight:600;}
  #menuClose{margin-top:auto; padding:12px; border-radius:10px; border:1px solid var(--line);
    background:none; color:var(--text-dim); font-size:14px;}

  /* ---------- Almenü képernyők (Szektorok / Leltár / Ellenőrzés) ---------- */
  .subScreen{display:none; position:fixed; inset:0; z-index:55; background:var(--bg);
    flex-direction:column;}
  .subScreen.show{display:flex;}
  .subScreenHeader{flex:0 0 auto; display:flex; align-items:center; gap:12px;
    padding:12px 14px; background:var(--panel); border-bottom:1px solid var(--line);}
  .backBtn{border:none; background:none; color:var(--accent); font-size:14px; font-weight:600; padding:6px 0;}
  .subScreenHeader b{font-size:15px;}
  .subScreenBody{flex:1 1 auto; overflow-y:auto; padding:16px;}
  .placeholderNote{color:var(--text-dim); font-size:14px; line-height:1.6;}

  #sectorAddRow{display:flex; gap:8px; margin-bottom:16px;}
  #newSectorInput{flex:1; background:var(--panel-2); border:1px solid var(--line); border-radius:10px;
    padding:10px 12px; color:var(--text); font-size:14px;}
  #addSectorBtn{flex:0 0 auto; padding:0 16px; border-radius:10px; border:none;
    background:var(--accent); color:#06231a; font-weight:700;}
  .sectorRow{display:flex; align-items:center; justify-content:space-between;
    padding:12px 14px; background:var(--panel); border:1px solid var(--line); border-radius:10px; margin-bottom:8px;}
  .sectorRow .delSectorBtn{background:none; border:none; color:var(--danger); font-size:16px;}

  /* ---------- Leltár képernyő ---------- */
  .leltarSectionTitle{font-size:13px; font-weight:700; color:var(--text-dim);
    text-transform:uppercase; letter-spacing:.04em; margin:20px 0 10px;}
  .leltarSectionTitle:first-child{margin-top:0;}
  .typeChoice{display:flex; flex-direction:column; gap:8px; margin-bottom:14px;}
  .typeChoice label{display:flex; align-items:center; gap:10px; padding:12px 14px;
    background:var(--panel); border:1px solid var(--line); border-radius:10px; font-size:14px;}
  .typeChoice input[type=radio]{accent-color:var(--accent);}
  #productTypeList{display:flex; flex-direction:column; gap:6px; max-height:220px;
    overflow-y:auto; margin-bottom:14px; padding:4px 0;}
  #productTypeList label{display:flex; align-items:center; gap:10px; padding:9px 12px;
    background:var(--panel); border:1px solid var(--line); border-radius:8px; font-size:13px;}
  #productTypeList input[type=checkbox]{accent-color:var(--accent);}
  .bigBtn{width:100%; padding:14px; border-radius:12px; border:none; font-size:15px;
    font-weight:700; background:var(--accent); color:#06231a;}
  .bigBtn:disabled{opacity:.4;}
  .joinRow{display:flex; gap:8px; margin-bottom:8px;}
  .joinRow input{flex:1; background:var(--panel-2); border:1px solid var(--line); border-radius:10px;
    padding:10px 12px; color:var(--text); font-size:16px; letter-spacing:.1em; text-transform:uppercase;}
  .joinRow button{flex:0 0 auto; padding:0 16px; border-radius:10px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--text); font-weight:700;}
  .secondaryBtn{width:100%; padding:12px; border-radius:10px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--text); font-size:14px; font-weight:600; margin-top:8px;}

  #activeLeltarBox{text-align:center; padding:8px 0;}
  #activeLeltarBox .codeLabel{font-size:12px; color:var(--text-dim); margin-bottom:6px;}
  #activeLeltarBox .codeValue{font-size:32px; font-weight:800; letter-spacing:.12em; margin-bottom:16px;}
  #qrCanvas{margin:0 auto 16px; display:block; background:#fff; padding:10px; border-radius:10px;}
  #activeLeltarMeta{font-size:13px; color:var(--text-dim); margin-bottom:20px;}
  #closeLeltarBtn{width:100%; padding:14px; border-radius:12px; border:none;
    background:var(--danger); color:#fff; font-size:15px; font-weight:700;}

  .diffRow{display:flex; align-items:center; gap:10px; padding:12px 14px;
    background:var(--panel); border:1px solid var(--line); border-radius:10px; margin-bottom:8px;}
  .diffRow .info{flex:1; min-width:0;}
  .diffRow .info b{display:block; font-size:14px;}
  .diffRow .info span{font-size:11px; color:var(--text-dim); display:block; margin-top:2px;}
  .diffRow .diffVal{font-size:16px; font-weight:800; min-width:52px; text-align:right;}
  .diffVal.pos{color:var(--accent);}
  .diffVal.neg{color:var(--danger);}
  .diffVal.zero{color:var(--text-dim);}
  .otherWarehouses{font-size:11px; color:var(--text-dim); margin-top:4px;}

  /* ---------- QR beolvasó overlay (csatlakozáshoz) ---------- */
  #joinScanCamWrap{position:relative; flex:1; background:#000; overflow:hidden;}
  #joinVideo{width:100%; height:100%; object-fit:cover;}
  #joinScanMsg{position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    color:var(--text-dim); font-size:14px; text-align:center; padding:24px; background:rgba(0,0,0,0.4);}

  /* ---------- Ellenőrzés képernyő ---------- */
  #checkCamWrap{position:relative; flex:0 0 42vh; background:#000; overflow:hidden;}
  #checkVideo{width:100%; height:100%; object-fit:cover; display:block;}
  #checkGuide{position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
    width:78%; max-width:360px; aspect-ratio:16/9;
    border:2px solid rgba(255,255,255,0.28); border-radius:16px; pointer-events:none;}
  #checkMsg{position:absolute; left:0; right:0; bottom:10px; text-align:center;
    color:var(--text-dim); font-size:12px; pointer-events:none;}
  .checkResultCard{background:var(--panel); border:1px solid var(--line); border-radius:12px;
    padding:16px; margin-bottom:12px;}
  .checkResultCard .modelName{font-size:16px; font-weight:700; margin-bottom:2px;}
  .checkResultCard .modelCode{font-size:12px; color:var(--text-dim); margin-bottom:14px;}
  .checkSizeRow{display:flex; align-items:center; justify-content:space-between;
    padding:8px 0; border-bottom:1px solid var(--line); font-size:14px;}
  .checkSizeRow:last-child{border-bottom:none;}
  .checkSizeRow .qty{font-weight:700;}
  .checkSizeRow .qty.zero{color:var(--danger);}

  /* ---------- Kamera terület ---------- */
  #camWrap{position:relative; flex:1 1 auto; min-height:0; background:#000; overflow:hidden;}
  video{width:100%; height:100%; object-fit:cover; display:block;}

  #torchBtn{position:absolute; top:8px; right:8px; width:40px; height:40px; z-index:6;
    border-radius:50%; border:1px solid rgba(255,255,255,0.3); background:rgba(0,0,0,0.5);
    color:#fff; font-size:18px; display:none; align-items:center; justify-content:center;
    line-height:1; padding:0;}
  #torchBtn.show{display:flex;}
  canvas#overlay{position:absolute; inset:0; width:100%; height:100%; pointer-events:none;}

  .guide{
    position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
    width:78%; max-width:420px; aspect-ratio:16/9;
    border:2px solid rgba(255,255,255,0.28); border-radius:16px; pointer-events:none;
    transition:border-color .15s ease, box-shadow .15s ease;}
  .guide.active{border-color:var(--accent); box-shadow:0 0 0 4px rgba(62,207,142,0.25);}
  .guide::before,.guide::after{content:""; position:absolute; width:22px; height:22px;
    border-color:var(--accent); border-style:solid;}
  .guide::before{top:-2px; left:-2px; border-width:3px 0 0 3px; border-top-left-radius:16px;}
  .guide::after{bottom:-2px; right:-2px; border-width:0 3px 3px 0; border-bottom-right-radius:16px;}

  .scanLine{
    position:absolute; left:4%; right:4%; top:50%; height:2px; border-radius:2px;
    background:var(--accent); box-shadow:0 0 10px 2px rgba(62,207,142,0.75);
    transform:translateY(-50%);}

  #camWrap.flash::after{content:""; position:absolute; inset:0; background:var(--accent);
    opacity:0; animation: flashPulse .35s ease-out; pointer-events:none;}
  @keyframes flashPulse{0%{opacity:.35;} 100%{opacity:0;}}
  @keyframes focusRipple{0%{transform:scale(0.6); opacity:1;} 100%{transform:scale(1.15); opacity:0;}}

  #camMsg{position:absolute; inset:0; display:none; align-items:center; justify-content:center;
    text-align:center; padding:24px; color:var(--text-dim); font-size:14px; background:var(--bg);}
  #camMsg.show{display:flex;}

  /* ---------- Aktuális találat kártya ---------- */
  #hit{
    position:absolute; left:12px; right:12px; bottom:12px;
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
    padding:14px; display:none; box-shadow:0 8px 24px rgba(0,0,0,0.4);
    transform:translateY(12px); opacity:0; transition:transform .18s ease, opacity .18s ease;}
  #hit.show{display:block; transform:translateY(0); opacity:1;}
  #hit.unknown{border-color:var(--warn);}
  .hitTop{display:flex; justify-content:space-between; align-items:flex-start; gap:10px;}
  .hitName{font-size:17px; font-weight:600; line-height:1.25;}
  .hitBarcode{font-size:12px; color:var(--text-dim); margin-top:2px; font-variant-numeric:tabular-nums;}
  .hitBadge{font-size:11px; padding:3px 8px; border-radius:999px; background:var(--accent-dim);
    color:var(--accent); font-weight:600; white-space:nowrap;}
  .hitBadge.warn{background:#4a3a17; color:var(--warn);}

  .qtyRow{display:flex; align-items:center; gap:8px; margin-top:12px;}
  .qtyBtn{width:40px; height:44px; flex:0 0 40px; border-radius:10px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--text); font-size:20px; font-weight:600;}
  .qtyBtn:active{background:var(--line);}
  #qtyInput{flex:1 1 0; min-width:0; text-align:center; font-size:22px; font-weight:600; height:44px;
    background:var(--panel-2); border:1px solid var(--line); border-radius:10px; color:var(--text);}
  #nextBtn{flex:0 0 auto; height:44px; padding:0 14px; border-radius:10px; border:none;
    background:var(--accent); color:#06231a; font-size:15px; font-weight:700;}

  /* ---------- Lista-panel: legutolsó tétel + lenyitható előzmények ---------- */
  #listPanel{flex:0 0 auto; background:var(--panel); border-top:1px solid var(--line);
    display:flex; flex-direction:column;}
  #listPanel.empty{display:none;}
  #listPanel.bump{animation: toggleBump .28s ease;}
  @keyframes toggleBump{35%{transform:scale(1.015);}}

  #latestRow{flex:0 0 auto; cursor:pointer;}

  #listToggle{flex:0 0 auto; width:100%; text-align:center; color:var(--text-dim);
    display:none; padding:2px 16px 8px; font-size:12px; font-weight:600;}
  #listToggle.show{display:block;}

  #list{overflow-y:auto; max-height:0; transition:max-height .22s ease; -webkit-overflow-scrolling:touch;}
  #listPanel.expanded #list{max-height:38vh; border-top:1px solid var(--line);}

  .rowItem{display:flex; align-items:center; gap:10px; padding:10px 16px; border-bottom:1px solid var(--line);}
  .rowItem .info{flex:1; min-width:0;}
  .rowItem .info b{display:block; font-size:14px; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .rowItem .info span{font-size:11px; color:var(--text-dim);}
  .rowItem .qtyEdit{display:flex; align-items:center; gap:4px; flex:0 0 auto;}
  .rowItem .qtyEdit button{width:26px; height:26px; border-radius:8px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--text); font-size:15px; line-height:1; padding:0;}
  .rowItem .qtyEdit .qtyVal{min-width:26px; text-align:center; font-size:14px; font-weight:600;}
  .rowItem .delBtn{background:none; border:none; color:var(--text-dim); font-size:16px; padding:4px 2px 4px 8px;}

  /* ---------- Törlés megerősítő ablak ---------- */
  #confirmOverlay{display:none; position:fixed; inset:0; z-index:50;
    background:rgba(0,0,0,0.55); align-items:center; justify-content:center; padding:24px;}
  #confirmOverlay.show{display:flex;}
  #confirmBox{background:var(--panel-2); border:1px solid var(--line); border-radius:14px;
    padding:20px; max-width:320px; width:100%; text-align:center;}
  #confirmText{font-size:15px; font-weight:600; margin-bottom:4px;}
  #confirmName{font-size:13px; color:var(--text-dim); margin-bottom:16px;}
  #confirmButtons{display:flex; gap:10px;}
  #confirmButtons button{flex:1; padding:11px; border-radius:10px; border:none;
    font-size:14px; font-weight:700;}
  #confirmCancel{background:var(--accent); color:#06231a;}
  #confirmDelete{background:var(--danger); color:#fff;}

  /* ---------- Lábléc ---------- */
  footer{flex:0 0 auto; display:flex; gap:10px; padding:10px 14px;
    background:var(--panel); border-top:1px solid var(--line);}
  footer button{flex:1; padding:12px; border-radius:10px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--text); font-size:14px; font-weight:600;}
  footer button.primary{background:var(--accent); color:#06231a; border:none;}
  footer button:disabled{opacity:.4;}

  .sr-only{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0);}

  /* ---------- Fekvő tájolás blokkolása ---------- */
  #rotateLock{display:none; position:fixed; inset:0; z-index:999; background:var(--bg);
    color:var(--text); flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:32px;}
  #rotateLock .icon{font-size:40px; margin-bottom:12px;}
  @media (orientation: landscape) and (max-height: 500px) {
    #rotateLock{display:flex;}
  }
</style>
</head>
<body>
<div id="rotateLock">
  <div class="icon">📱</div>
  <div>Ez az alkalmazás csak álló tájolásban használható.<br>Fordítsd vissza a telefont.</div>
</div>
<div id="app">

  <header>
    <button id="menuBtn" aria-label="Menü">☰</button>
    <select id="sectorSelect" aria-label="Szektor kiválasztása">
      <option value="">Szektor kiválasztása…</option>
    </select>
    <div class="dot" id="netDot" title="Kapcsolat állapota"></div>
    <div class="stat">
      <b id="itemCount">0</b>
      <span>tétel</span>
    </div>
  </header>

  <!-- Hamburgermenü -->
  <div id="menuOverlay">
    <div id="menuBox">
      <button class="menuItem" data-screen="leltar">🔗 Csatlakozás leltárhoz</button>
      <button class="menuItem" data-screen="ellenorzes">🔍 Ellenőrzés</button>
      <button id="menuClose">Bezárás</button>
    </div>
  </div>

  <!-- Leltár (placeholder — a végleges verzió a backend-döntések után készül) -->
  <div id="leltarScreen" class="subScreen">
    <div class="subScreenHeader">
      <button class="backBtn" data-back>← Vissza</button>
      <b>Leltár</b>
    </div>
    <div class="subScreenBody" id="leltarBody"></div>
  </div>

  <!-- QR-kód beolvasása csatlakozáshoz (önálló, kis kamera-nézet) -->
  <div id="joinScanScreen" class="subScreen" style="z-index:70;">
    <div class="subScreenHeader">
      <button class="backBtn" id="joinScanClose">← Vissza</button>
      <b>QR-kód beolvasása</b>
    </div>
    <div id="joinScanCamWrap">
      <video id="joinVideo" autoplay playsinline muted></video>
      <div id="joinScanMsg"></div>
    </div>
  </div>

  <!-- Ellenőrzés: kamerás vonalkód-lekérdezés, modellenként/méretenként -->
  <div id="ellenorzesScreen" class="subScreen">
    <div class="subScreenHeader">
      <button class="backBtn" data-back>← Vissza</button>
      <b>Ellenőrzés</b>
    </div>
    <div id="checkCamWrap">
      <video id="checkVideo" autoplay playsinline muted></video>
      <div class="guide" id="checkGuide"></div>
      <div id="checkMsg">Irányítsd a kamerát egy vonalkódra</div>
    </div>
    <div class="subScreenBody" id="checkResultBody"></div>
  </div>

  <div id="camWrap">
    <video id="video" autoplay playsinline muted></video>
    <canvas id="overlay"></canvas>
    <div class="guide" id="guide" style="display:none;"><div class="scanLine" id="scanLine"></div></div>
    <div id="camMsg"></div>
    <button id="startBtn" style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
      padding:16px 28px; font-size:16px; font-weight:700; border:none; border-radius:12px;
      background:var(--accent); color:#06231a; z-index:5; display:none;">Kamera indítása</button>
    <div id="selectSectorHint" style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
      color:var(--text-dim); font-size:14px; text-align:center; padding:0 24px;">
      Válassz szektort a kamera indításához ⬆️</div>
    <button id="torchBtn" aria-label="Vaku">🔦</button>
    <div id="debugBar" style="position:absolute; top:6px; left:8px; font-size:9px;
      color:rgba(255,255,255,0.35); font-family:monospace; pointer-events:none; z-index:2;"></div>

    <div id="hit">
      <div class="hitTop">
        <div>
          <div class="hitName" id="hitName">—</div>
          <div class="hitBarcode" id="hitBarcode">—</div>
        </div>
        <div class="hitBadge" id="hitBadge">ismert</div>
      </div>
      <div class="qtyRow">
        <button class="qtyBtn" id="qtyMinus" aria-label="Mennyiség csökkentése">–</button>
        <input id="qtyInput" inputmode="numeric" pattern="[0-9]*" value="1" aria-label="Mennyiség">
        <button class="qtyBtn" id="qtyPlus" aria-label="Mennyiség növelése">+</button>
        <button id="nextBtn">Rögzít</button>
      </div>
    </div>
  </div>

  <div id="listPanel" class="empty">
    <div id="latestRow"></div>
    <div id="listToggle">
      <span id="toggleLabel">Korábbi tételek</span>
    </div>
    <div id="list"></div>
  </div>

  <div id="confirmOverlay">
    <div id="confirmBox">
      <div id="confirmText">Biztosan törlöd ezt a tételt?</div>
      <div id="confirmName"></div>
      <div id="confirmButtons">
        <button id="confirmCancel">Mégse</button>
        <button id="confirmDelete">Törlés</button>
      </div>
    </div>
  </div>

  <footer>
    <button id="closeSectorBtn">Szektor lezárása</button>
    <button id="syncBtn" class="primary">Szinkronizálás (<span id="pendingCount">0</span>)</button>
  </footer>

</div>

<script>
try {
/* =========================================================================
   DEMO TERMÉKTÖRZS
   Éles verzióban ez egy Apps Script Web App hívás lenne, ami a BigQuery
   cikktörzs táblát nézi le vonalkód alapján. Lásd a lookupProduct()
   függvényt legalul — ott van kikommentezve a valós fetch hívás.
   ========================================================================= */
const DEMO_PRODUCTS = {
  "5901234123457": "Coca-Cola 0,5L",
  "5449000000996": "Fanta Narancs 0,5L",
  "4006381333931": "Nivea testápoló 250ml",
  "8710398503968": "Pampers pelenka 4-es",
  "3017620422003": "Nutella 400g",
  "5000159407236": "Mars csokoládé",
  "7622210951557": "Milka tábla 100g",
  "5410228131488": "Jägermeister 0,7L",
};

/* =========================================================================
   BACKEND (Apps Script) HÍVÁSOK
   Ezt a blokkot szándékosan a fájl elején tartjuk, hogy bárhonnan
   (akár a szkript elején lefutó kódból is) biztonságosan hívható legyen —
   korábban a fájl végén volt, ami "let" időzítési hibát okozott.
   ========================================================================= */
