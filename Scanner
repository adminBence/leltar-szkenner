/* =========================================================================
   VAKU (torch) és ÉRINTÉSRE-FÓKUSZ
   Fontos: iOS Safari-n ezek jellemzően NEM támogatottak webes API-n
   keresztül (Apple oldali korlátozás) — ott a gombok/érintés egyszerűen
   nem csinálnak semmit, hibaüzenet nélkül. Android Chrome-on sok
   eszközön működnek.
   ========================================================================= */
let torchOn = false;

function getActiveVideoTrack() {
  return activeStream ? activeStream.getVideoTracks()[0] : null;
}

function refreshTorchButton() {
  const track = getActiveVideoTrack();
  const btn = el("torchBtn");
  if (!btn) return;
  try {
    const caps = track && track.getCapabilities ? track.getCapabilities() : null;
    btn.style.display = (caps && caps.torch) ? "flex" : "none";
  } catch (e) {
    btn.style.display = "none";
  }
}

el("torchBtn").addEventListener("click", async () => {
  const track = getActiveVideoTrack();
  if (!track) return;
  try {
    torchOn = !torchOn;
    await track.applyConstraints({ advanced: [{ torch: torchOn }] });
    el("torchBtn").style.background = torchOn ? "var(--accent)" : "rgba(0,0,0,0.5)";
  } catch (e) {
    debugLog("vaku hiba: " + (e.message || e));
  }
});

// Érintésre-fókusz: a kamera-kép megérintett pontjára próbál fókuszálni,
// ahol a böngésző/eszköz ezt támogatja.
el("camWrap").addEventListener("click", async (ev) => {
  if (ev.target.closest("#startBtn, #torchBtn, #hit")) return;
  const track = getActiveVideoTrack();
  if (!track || !track.getCapabilities) return;

  const rect = el("camWrap").getBoundingClientRect();
  const x = (ev.clientX - rect.left) / rect.width;
  const y = (ev.clientY - rect.top) / rect.height;

  // Rövid vizuális visszajelzés az érintésnél, függetlenül attól,
  // hogy a fókuszálás ténylegesen támogatott-e az eszközön.
  showFocusRipple(ev.clientX - rect.left, ev.clientY - rect.top);

  try {
    const caps = track.getCapabilities();
    if (caps.pointsOfInterest) {
      await track.applyConstraints({ advanced: [{ pointsOfInterest: [{ x, y }] }] });
    }
    if (caps.focusMode && caps.focusMode.includes("single-shot")) {
      await track.applyConstraints({ advanced: [{ focusMode: "single-shot" }] });
    }
  } catch (e) {
    // Nem támogatott eszközön/böngészőn csendben nem csinál semmit.
  }
});

function showFocusRipple(x, y) {
  const ripple = document.createElement("div");
  ripple.style.cssText = `position:absolute; left:${x}px; top:${y}px; width:56px; height:56px;
    margin:-28px 0 0 -28px; border:2px solid var(--accent); border-radius:50%;
    pointer-events:none; z-index:7; animation: focusRipple .5s ease-out forwards;`;
  el("camWrap").appendChild(ripple);
  setTimeout(() => ripple.remove(), 500);
}


/* ---------- Állapot ---------- */
let activeLeltar = null;        // { leltar_id, code, tipus, raktar }
let userEmail = "";             // ha van bejelentkezés-infó, ide kerülhet

document.querySelector('.menuItem[data-screen="leltar"]').addEventListener("click", renderLeltarScreen);

function renderLeltarScreen() {
  const body = el("leltarBody");

  if (!APPS_SCRIPT_URL) {
    body.innerHTML = `<p class="placeholderNote">
      Még nincs beállítva az Apps Script backend URL-je a kódban
      (<code>APPS_SCRIPT_URL</code>).
    </p>`;
    return;
  }

  if (activeLeltar) { renderActiveLeltarStatus(body); return; }
  renderJoinForm(body);
}

/* ---------- Nincs csatlakozva: kód beírása vagy QR beolvasása ---------- */
function renderJoinForm(body) {
  body.innerHTML = `
    <div class="leltarSectionTitle">Csatlakozás futó leltárhoz</div>
    <p class="placeholderNote">Az admin felületen indított leltárhoz tudsz csatlakozni —
    kérd el tőle a csatlakozási kódot, vagy olvasd be a kivetített QR-kódot.</p>
    <div class="joinRow">
      <input id="joinCodeInput" placeholder="pl. AB12CD" maxlength="6">
      <button id="joinCodeBtn">Csatlakozás</button>
    </div>
    <button class="secondaryBtn" id="joinQrBtn">📷 QR-kód beolvasása</button>
  `;
  el("joinCodeBtn").addEventListener("click", () => {
    const code = el("joinCodeInput").value.trim();
    if (code) joinLeltarWithCode(code);
  });
  el("joinQrBtn").addEventListener("click", openJoinScanner);
}

async function joinLeltarWithCode(code) {
  try {
    const result = await apiGet({ action: "join", code: code });
    if (!result.found) { alert("Nincs ilyen csatlakozási kód."); return; }
    if (!result.active) { alert(result.message || "Ez a leltár már nem aktív."); return; }
    activeLeltar = { leltar_id: result.leltar_id, code: code.toUpperCase(), tipus: result.tipus, raktar: result.raktar };
    renderLeltarScreen();
  } catch (e) {
    alert("Hiba a csatlakozáskor: " + e.message);
  }
}

/* ---------- Csatlakozva: állapot-kijelzés (a lezárás az admin dolga) ---------- */
function renderActiveLeltarStatus(body) {
  body.innerHTML = `
    <div id="activeLeltarBox">
      <div class="codeLabel">Csatlakozva ehhez a leltárhoz</div>
      <div class="codeValue" style="font-size:22px;">${escapeHtml(activeLeltar.code)}</div>
      <div id="activeLeltarMeta">Válassz szektort a fejlécben, és kezdheted a beolvasást.
      A leltár lezárása és az eltérés-riport az admin felületen történik.</div>
      <button class="secondaryBtn" id="leaveLeltarBtn">Leválasztás erről a leltárról</button>
    </div>
  `;
  el("leaveLeltarBtn").addEventListener("click", () => {
    activeLeltar = null;
    renderLeltarScreen();
  });
}

/* =========================================================================
   QR-KÓD BEOLVASÁSA (csatlakozáshoz) — önálló, egyszerű kamera-nézet,
   nem érinti a fő szkenner állapotát.
   ========================================================================= */
let joinStream = null;
let joinScanning = false;

async function openJoinScanner() {
  el("joinScanScreen").classList.add("show");
  joinScanning = true;
  try {
    joinStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: { ideal: "environment" } }, audio: false,
    });
    const v = el("joinVideo");
    v.srcObject = joinStream;
    await v.play();
    requestAnimationFrame(joinScanLoop);
  } catch (e) {
    el("joinScanMsg").textContent = "Kamera hiba: " + e.message;
  }
}

function closeJoinScanner() {
  joinScanning = false;
  el("joinScanScreen").classList.remove("show");
  if (joinStream) { joinStream.getTracks().forEach(t => t.stop()); joinStream = null; }
}
el("joinScanClose").addEventListener("click", closeJoinScanner);

async function joinScanLoop() {
  if (!joinScanning) return;
  const v = el("joinVideo");
  try {
    if (v.videoWidth) {
      if ("BarcodeDetector" in window) {
        const det = new BarcodeDetector({ formats: ["qr_code"] });
        const codes = await det.detect(v);
        if (codes.length) { handleJoinScanResult(codes[0].rawValue); return; }
      } else if (window.ZXingWASM) {
        const canvas = document.createElement("canvas");
        canvas.width = v.videoWidth; canvas.height = v.videoHeight;
        canvas.getContext("2d").drawImage(v, 0, 0);
        const imgData = canvas.getContext("2d").getImageData(0, 0, canvas.width, canvas.height);
        const results = await ZXingWASM.readBarcodesFromImageData(imgData, { formats: ["QRCode"], maxSymbols: 1 });
        if (results && results.length) { handleJoinScanResult(results[0].text); return; }
      }
    }
  } catch (e) { /* átmeneti hiba, folytatjuk */ }
  requestAnimationFrame(joinScanLoop);
}

function handleJoinScanResult(code) {
  closeJoinScanner();
  el("joinCodeInput") && (el("joinCodeInput").value = code);
  joinLeltarWithCode(code);
}

/* =========================================================================
   ELLENŐRZÉS — kamerás vonalkód-lekérdezés: modellenként/méretenként
   megmutatja a raktári készletet. Önálló kamera-kezelés, nem érinti a
   fő szkenner állapotát.
   ========================================================================= */
let checkStream = null;
let checkScanning = false;
let checkLastCode = null;
let checkLastAt = 0;

document.querySelector('.menuItem[data-screen="ellenorzes"]').addEventListener("click", openCheckScanner);
document.querySelectorAll('#ellenorzesScreen [data-back]').forEach(btn => {
  btn.addEventListener("click", closeCheckScanner);
});

async function openCheckScanner() {
  checkScanning = true;
  el("checkResultBody").innerHTML = "";
  el("checkMsg").textContent = "Irányítsd a kamerát egy vonalkódra";
  try {
    checkStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: { ideal: "environment" } }, audio: false,
    });
    const v = el("checkVideo");
    v.srcObject = checkStream;
    await v.play();
    requestAnimationFrame(checkScanLoop);
  } catch (e) {
    el("checkMsg").textContent = "Kamera hiba: " + e.message;
  }
}

function closeCheckScanner() {
  checkScanning = false;
  if (checkStream) { checkStream.getTracks().forEach(t => t.stop()); checkStream = null; }
}

async function checkScanLoop() {
  if (!checkScanning) return;
  const v = el("checkVideo");
  try {
    if (v.videoWidth) {
      let code = null;
      if ("BarcodeDetector" in window) {
        const det = new BarcodeDetector({
          formats: ["ean_13", "ean_8", "upc_a", "upc_e", "code_128", "code_39", "itf", "qr_code"],
        });
        const codes = await det.detect(v);
        if (codes.length) code = codes[0].rawValue;
      } else if (window.ZXingWASM) {
        const canvas = document.createElement("canvas");
        canvas.width = v.videoWidth; canvas.height = v.videoHeight;
        canvas.getContext("2d").drawImage(v, 0, 0);
        const imgData = canvas.getContext("2d").getImageData(0, 0, canvas.width, canvas.height);
        const results = await ZXingWASM.readBarcodesFromImageData(imgData, { tryHarder: true, maxSymbols: 1 });
        if (results && results.length) code = results[0].text;
      }
      if (code) {
        const now = Date.now();
        // Duplikáció-védelem: ugyanazt a kódot ne kérdezzük le újra és
        // újra másodpercenként többször, amíg a kamera rajta van.
        if (code !== checkLastCode || now - checkLastAt > 4000) {
          checkLastCode = code;
          checkLastAt = now;
          handleCheckScanResult(code);
        }
      }
    }
  } catch (e) { /* átmeneti hiba, folytatjuk */ }
  requestAnimationFrame(checkScanLoop);
}

async function handleCheckScanResult(barcode) {
  el("checkMsg").textContent = "Keresés: " + barcode + "…";
  try {
    const data = await apiGet({ action: "check_stock", barcode: barcode });
    if (!data.found) {
      el("checkResultBody").innerHTML = `<p class="placeholderNote">
        A(z) ${escapeHtml(barcode)} vonalkód nem található a terméktörzsben.</p>`;
      el("checkMsg").textContent = "Irányítsd a kamerát egy vonalkódra";
      return;
    }
    const sizesHtml = data.sizes.length
      ? data.sizes.map(s => `
          <div class="checkSizeRow">
            <span>${escapeHtml(s.meret)}</span>
            <span class="qty${s.mennyiseg === 0 ? " zero" : ""}">${s.mennyiseg} db</span>
          </div>`).join("")
      : `<p class="placeholderNote">Nincs készlet-adat ehhez a modellhez.</p>`;
    el("checkResultBody").innerHTML = `
      <div class="checkResultCard">
        <div class="modelName">${escapeHtml(data.nev)}</div>
        <div class="modelCode">${escapeHtml(data.modell)}</div>
        ${sizesHtml}
      </div>`;
    el("checkMsg").textContent = "Irányítsd a kamerát a következő vonalkódra";
    beep(880); haptic(20);
  } catch (e) {
    el("checkResultBody").innerHTML = `<p class="placeholderNote">Hiba: ${escapeHtml(e.message)}</p>`;
  }
}

} catch (e) {
  alert("KRITIKUS HIBA a szkriptben: " + (e && e.stack ? e.stack : e));
}
