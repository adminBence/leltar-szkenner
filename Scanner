          sector: s.sector, barcode: s.barcode, qty: s.qty, user: userEmail || "ismeretlen",
        })),
      });
      pendingItems.forEach(s => s.synced = true);
    } catch (e) {
      alert("Szinkronizálási hiba: " + e.message);
    }
  } else {
    // Demo mód (nincs beállítva backend URL, vagy nincs aktív leltár) —
    // csak lokálisan jelöljük szinkronizáltnak, hogy a felület tesztelhető legyen.
    await new Promise(r => setTimeout(r, 400));
    scanned.forEach(s => s.synced = true);
  }

  btn.disabled = false;
  updatePendingCount();
  btn.innerHTML = `Szinkronizálás (<span id="pendingCount">0</span>)`;
});

function updatePendingCount() {
  const pending = scanned.filter(s => !s.synced).length;
  el("pendingCount") && (el("pendingCount").textContent = pending);
}

/* =========================================================================
   LISTA MEGJELENÍTÉS
   - Egy koppintható sáv mindig mutatja a legutolsó beolvasott tételt.
