/* =========================================================================
   KÖZÖS: a keret (guide) által kijelölt terület kivágása és felnagyítása
   Ez a legfontosabb javítás a felismerés megkönnyítésére — ahelyett, hogy
   a teljes videóképet elemeznénk (amiben egy távoli/kicsi vonalkód csak
   pár pixelt foglal el), csak a keretben lévő, felhasználó által
   pozicionált részt vizsgáljuk, felnagyítva. Ez mindkét motornál
   (natív és ZXing) jelentősen javítja a találati arányt.
   ========================================================================= */
const cropCanvas = document.createElement("canvas");
const cropCtx = cropCanvas.getContext("2d", { willReadFrequently: true });

function captureGuideCrop(upscale = 2.2) {
  const vw = video.videoWidth, vh = video.videoHeight;
  if (!vw || !vh) return null;

  const videoRect = video.getBoundingClientRect();
  const guideRect = guide.getBoundingClientRect();

  // object-fit:cover miatt a videó egy része "levágva" látszik — ezt
  // ki kell számolni, hogy a keret pontos videó-pixel koordinátáit kapjuk.
  const scale = Math.max(videoRect.width / vw, videoRect.height / vh);
  const dispW = vw * scale, dispH = vh * scale;
  const offsetX = (dispW - videoRect.width) / 2;
  const offsetY = (dispH - videoRect.height) / 2;

  const sx = (guideRect.left - videoRect.left + offsetX) / scale;
  const sy = (guideRect.top - videoRect.top + offsetY) / scale;
  const sw = guideRect.width / scale;
  const sh = guideRect.height / scale;
  if (sw <= 0 || sh <= 0) return null;

  // Biztonsági levágás: a drawImage érvénytelen (negatív vagy a videó
  // méretén túlnyúló) forrás-téglalapra hibát dobna némely böngészőben.
  const sxC = Math.max(0, Math.min(sx, vw - 1));
  const syC = Math.max(0, Math.min(sy, vh - 1));
  const swC = Math.max(1, Math.min(sw, vw - sxC));
  const shC = Math.max(1, Math.min(sh, vh - syC));

  cropCanvas.width = Math.round(swC * upscale);
  cropCanvas.height = Math.round(shC * upscale);
  // A sima (nem kikapcsolt) simítás jobb eredményt ad a dekódolásnál,
  // mint az élesen pixeles verzió — a dekóder algoritmusok a finom
  // élátmenetekből pontosabban számolnak.
  cropCtx.imageSmoothingEnabled = true;
  cropCtx.imageSmoothingQuality = "high";
  cropCtx.drawImage(video, sxC, syC, swC, shC, 0, 0, cropCanvas.width, cropCanvas.height);

  return cropCanvas;
}

// Vizuális visszajelzés a keret felvillanásával, amikor a kivágott
// területen bármit felismer a motor (pontos körvonal helyett — mert
// felnagyított/kivágott képen dolgozunk, a pontos pozíció nem 1:1
// mapolható vissza egyszerűen a képernyőre).
let guideActiveTimeout = null;
function highlightGuide() {
  guide.classList.add("active");
  clearTimeout(guideActiveTimeout);
  guideActiveTimeout = setTimeout(() => guide.classList.remove("active"), 250);
}

/* =========================================================================
   NATÍV BARCODEDETECTOR CIKLUS — a kivágott, felnagyított területen dolgozik
   ========================================================================= */
async function nativeScanLoop() {
  try {
    if (video.readyState >= 2 && video.videoWidth) {
      frameCount++;
      const crop = captureGuideCrop();
      if (crop) {
        const barcodes = await barcodeDetector.detect(crop);
        if (barcodes.length) { detectCount++; highlightGuide(); }
        handleDetections(barcodes.map(b => b.rawValue));
      }
      if (frameCount % 20 === 0) {
        debugLog(`natív mód · videó: ${video.videoWidth}x${video.videoHeight} · `
          + `${frameCount} kocka feldolgozva · ${detectCount} találat`);
      }
    } else {
      debugLog(`videó nem kész (readyState=${video.readyState}, width=${video.videoWidth})`);
    }
  } catch (e) {
    debugLog("nativeScanLoop hiba: " + (e && e.message ? e.message : e));
  }
  requestAnimationFrame(nativeScanLoop);
}

/* =========================================================================
   FALLBACK: ZXing (Safari / iOS, ahol nincs natív BarcodeDetector)
   Itt is a kivágott, felnagyított területet elemezzük, saját ütemezett
   ciklusban — nem a könyvtár beépített, teljes képkockás folyamatos
   motorját használjuk, hogy egységes legyen a logika a natív úttal.
   ========================================================================= */

// Előtöltjük a ZXing könyvtárat MÁR az oldal betöltésekor, a háttérben —
// így gombnyomáskor nincs hálózati késleltetés, ami elszakítaná iOS-en
// a felhasználói érintésből eredő engedélyt a videó lejátszásához.
function loadScript(src) {
  return new Promise((resolve, reject) => {
    const s = document.createElement("script");
    s.src = src; s.onload = resolve; s.onerror = reject;
    document.head.appendChild(s);
  });
}

let fallbackLibPromise = null;
if (!("BarcodeDetector" in window)) {
  fallbackLibPromise = loadScript("https://cdn.jsdelivr.net/npm/zxing-wasm@latest/dist/iife/reader/index.js")
    .catch(e => { debugLog("előtöltési hiba (nem végzetes): " + e); });
}

async function startFallbackScanner() {
  setCamMsg("Tartalék szkenner betöltése…");

  try {
    if (!fallbackLibPromise) {
      fallbackLibPromise = loadScript("https://cdn.jsdelivr.net/npm/zxing-wasm@latest/dist/iife/reader/index.js");
    }
    await fallbackLibPromise;
  } catch (e) {
    setCamMsg("A szkenner könyvtár nem tölthető be.");
    debugLog("CDN betöltési hiba: " + e.message);
    return;
  }

  // Itt MI kérjük le a kamerát (folyamatos autófókusszal, ha a telefon
  // támogatja) — a WASM dekóder csak a kész képkockákat elemzi.
  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: { ideal: "environment" },
        width: { ideal: 4096 }, height: { ideal: 2160 },
        advanced: [{ focusMode: "continuous" }],
      },
      audio: false,
    });
    activeStream = stream;
    video.srcObject = stream;
    await video.play();
  } catch (e) {
    setCamMsg("A kamera nem érhető el. Engedélyezd a hozzáférést a böngésző beállításaiban.");
    debugLog("getUserMedia hiba: " + (e.message || e));
    return;
  }

  setCamMsg("");
  refreshTorchButton();
  debugLog(`tartalék mód (ZXing-WASM) · kamera fut · videó:${video.videoWidth}x${video.videoHeight}`);
  requestAnimationFrame(fallbackScanLoop);
}

let lastFallbackDecodeAt = 0;
let fallbackAttempts = 0, fallbackFound = 0;
async function fallbackScanLoop() {
  try {
    const now = Date.now();
    // A WASM dekódolás sokkal gyorsabb, mint a tiszta JS verzió volt,
    // ezért sűrűbben próbálkozhatunk anélkül, hogy akadozna a felület.
    if (now - lastFallbackDecodeAt > 90 && video.videoWidth) {
      lastFallbackDecodeAt = now;
      const crop = captureGuideCrop();
      if (crop) {
        fallbackAttempts++;
        try {
          const imageData = cropCtx.getImageData(0, 0, crop.width, crop.height);
          const results = await ZXingWASM.readBarcodesFromImageData(imageData, {
            tryHarder: true,
            maxSymbols: 1,
          });
          if (results && results.length) {
            fallbackFound++;
            highlightGuide();
            handleDetections([results[0].text]);
          } else {
            handleDetections([]);
          }
        } catch (e) {
          debugLog("ZXing-WASM decode hiba: " + (e && e.message ? e.message : e));
        }
        if (fallbackAttempts % 20 === 0) {
          debugLog(`tartalék (ZXing-WASM) · ${fallbackAttempts} próbálkozás · ${fallbackFound} találat`);
        }
      }
    }
  } catch (e) {
    debugLog("fallbackScanLoop hiba: " + (e && e.message ? e.message : e));
  }
  requestAnimationFrame(fallbackScanLoop);
}

/* =========================================================================
   FELISMERÉS FELDOLGOZÁSA
   - Mindkét motor (natív és ZXing) belsőleg ellenőrzi a vonalkód
     ellenőrző-számjegyét (checksum) dekódoláskor — egyetlen sikeres
     olvasás is megbízható, nem kell több egymást követő találat.
   - Ha egy MÁSIK kódot ismer fel, miközben az előző kártya még nyitva
     van, az előzőt az aktuális mennyiséggel automatikusan rögzíti,
     és rögtön az újra vált — ez adja a gördülékeny, megállás nélküli
     scannelést.
   - Ugyanaz a vonalkód csak akkor számít "újra beolvasottnak" (és
     kapja +1-et a mennyisége), ha közben egy pillanatra eltűnt a
     képből — ez engedi, hogy pl. két egyforma terméket egymás után
     beolvass anélkül, hogy várni kelljen, de véd az ellen, hogy
     ugyanaz a mozdulatlan termék véletlenül duplán számoljon.
   ========================================================================= */
let lastSeenAt = 0;
function handleDetections(codes) {
  if (!codes.length) {
    candidateCode = null;
    candidateCount = 0;
    // Csak akkor számít ténylegesen "eltűntnek" a kód, ha egy ideje
    // (kb. fél másodperce) folyamatosan nem látja — így egy-egy
    // véletlenül kihagyott képkocka (gyakori a gyors, natív ciklusnál)
    // nem okoz azonnali, pörgős újra-beolvasást/villogást.
    if (Date.now() - lastSeenAt > 500) lastAcceptedCode = null;
    return;
  }

  lastSeenAt = Date.now();

  // A guide-hoz legközelebbi / első kódot vesszük célnak.
  const code = codes[0];
  candidateCode = code;
  candidateCount = 1;

  if (code === lastAcceptedCode) return; // ugyanaz a kód, még mindig folyamatosan látszik
  if (pendingHit && code === pendingHit.barcode) return; // már ez van kártyán

  acceptCode(code);
}

async function acceptCode(barcode) {
  lastAcceptedCode = barcode;

  // Ha volt függőben lévő tétel, azt előbb véglegesítjük az aktuális mennyiséggel.
  if (pendingHit) commitPending();

  beep(880); haptic(25); flashScreen();

  const existing = scanned.find(s => s.barcode === barcode && s.sector === currentSector);
  const result = await lookupProduct(barcode);

  pendingHit = {
    barcode,
    name: result.found ? result.name : "Ismeretlen vonalkód",
    found: result.found,
    qty: existing ? existing.qty + 1 : 1,
    existing: !!existing,
  };
  renderHitCard();
}

function renderHitCard() {
  if (!pendingHit) { hitCard.classList.remove("show"); return; }
  el("hitName").textContent = pendingHit.name;
  el("hitBarcode").textContent = pendingHit.barcode;
  el("qtyInput").value = pendingHit.qty;
  const badge = el("hitBadge");
  if (pendingHit.found) {
    badge.textContent = pendingHit.existing ? "már szkennelve" : "ismert termék";
    badge.className = "hitBadge";
    hitCard.classList.remove("unknown");
  } else {
    badge.textContent = "nincs a törzsben";
    badge.className = "hitBadge warn";
    hitCard.classList.add("unknown");
  }
  hitCard.classList.add("show");
  el("qtyInput").focus();
  el("qtyInput").select();
}

function commitPending() {
  if (!pendingHit) return;
  const qty = Math.max(1, parseInt(el("qtyInput").value || "1", 10));
  const existing = scanned.find(s => s.barcode === pendingHit.barcode && s.sector === currentSector);
  if (existing) {
    existing.qty = qty;
    existing.ts = Date.now();
  } else {
    scanned.unshift({
      barcode: pendingHit.barcode,
      name: pendingHit.name,
      qty,
      sector: currentSector,
      ts: Date.now(),
    });
  }
  pendingHit = null;
  hitCard.classList.remove("show");
  renderList();
}

