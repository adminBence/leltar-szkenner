const audioCtx = window.AudioContext ? new AudioContext() : null;
function beep(freq = 880, dur = 0.06) {
  if (!audioCtx) return;
  const o = audioCtx.createOscillator();
  const g = audioCtx.createGain();
  o.frequency.value = freq;
  o.type = "sine";
  g.gain.value = 0.15;
  o.connect(g).connect(audioCtx.destination);
  o.start();
  g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
  o.stop(audioCtx.currentTime + dur);
}
function haptic(ms = 30) { if (navigator.vibrate) navigator.vibrate(ms); }
function flashScreen() {
  const wrap = document.getElementById("camWrap");
  wrap.classList.remove("flash");
  void wrap.offsetWidth; // kényszerített reflow, hogy az animáció újrainduljon gyors egymás utáni scanneknél is
  wrap.classList.add("flash");
}

